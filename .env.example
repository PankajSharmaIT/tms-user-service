# MySQL Configuration
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=traffic_monitoring
MYSQL_USER=tmsuser
MYSQL_PASSWORD=tmspassword

# Spring Boot Application Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/traffic_monitoring?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect

# Eureka Configuration (if needed)
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/

